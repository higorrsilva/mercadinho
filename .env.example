# Copie este arquivo para ".env" e preencha com os seus valores.
# NUNCA envie o arquivo ".env" para o GitHub.

# Supabase: Project Settings -> API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua-chave-do-supabase

# Chave que assina os tokens de login (texto longo e aleatório).
# Para gerar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio
